# Pipeline config. Copy to .env — demo.sh sources it.
# Everything here is an address, not a secret.

# NudgeBee AI gateway (the source runs from llm/gateway; see PLAN.md §4)
NB_GATEWAY_URL=http://localhost:8010
NB_TOKEN=nb-demo-token

# How the gateway addresses your model: "<provider>/<tag>"
# provider = the name you gave the JarvisLabs integration in NudgeBee
# tag      = exact model id from curl $GEMMA_BASE_URL/v1/models
NB_PROVIDER=jarvislabs
NB_MODEL=gemma-4-26b-a4b-it

# The failing job
JOB_NAME=oom-job
JOB_IMAGE=python:3.12-slim
FAIL_LIMIT=128m
FIX_LIMIT=1g
ALLOC_MB=512
