# Copy to .env.local. This file is ignored by Git. Never commit real keys.
BRIDGE_TOKEN=replace-with-long-random-token
RUBIX_SUBMIT_TOKEN=replace-with-different-long-random-token
NUDGEBEE_CALLBACK_TOKEN=replace-with-another-long-random-token
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_DB=mvp/evidence/bridge.db
EXECUTION_MODE=dry-run
JARVIS_BASE_URL=https://your-jarvis-host:6006/v1
JARVIS_MODEL=your-model-id
JARVIS_API_KEY=
NUDGEBEE_WEBHOOK_URL=
NUDGEBEE_WEBHOOK_TOKEN=
PUBLIC_BRIDGE_URL=
# For the official self-hosted NudgeBee chart, use an adequately sized context.
NUDGEBEE_KUBE_CONTEXT=
NUDGEBEE_ADMIN_EMAIL=
NUDGEBEE_ENCRYPTION_KEY=
